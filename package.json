{
  "name": "node-red-contrib-daichi-cloud",
  "version": "2.0.0",
  "description": "Node-RED nodes to monitor and control Daichi / Daikin HVAC units through Daichi Comfort Cloud",
  "keywords": [
    "air-conditioner",
    "daichi",
    "daikin",
    "hvac",
    "node-red"
  ],
  "homepage": "https://github.com/niklv/node-red-contrib-daichi-cloud",
  "bugs": "https://github.com/niklv/node-red-contrib-daichi-cloud/issues",
  "license": "MIT",
  "author": {
    "name": "Nikita Lvov",
    "email": "niklvov@gmail.com",
    "url": "https://github.com/niklv"
  },
  "repository": {
    "url": "git+https://github.com/niklv/node-red-contrib-daichi-cloud.git"
  },
  "files": [
    "build",
    "examples"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "prepack": "npm run build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "daichi": "^2.1.0",
    "mqtt": "^5.15.2"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/node-red": "^1.3.5",
    "@types/node-red-node-test-helper": "^0.3.5",
    "node-red": "^5.0.7",
    "node-red-node-test-helper": "^0.3.6",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "node-red": {
    "version": ">=5.0.0",
    "nodes": {
      "daichi-service": "./build/daichi-service.js",
      "daichi-device": "./build/daichi-device.js"
    }
  }
}
