{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": false,
  "trailingComma": "none",
  "arrowParens": "avoid",
  "sortImports": {
    "newlinesBetween": false
  },
  "ignorePatterns": ["build", "examples", "README.md", ".github", "package-lock.json"]
}
